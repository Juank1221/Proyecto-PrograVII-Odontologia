@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (ruta.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var destino = string.IsNullOrWhiteSpace(ruta) ? "usuarios" : ruta;
        var url = $"login?returnUrl={Uri.EscapeDataString("/" + destino.TrimStart('/'))}";

        Navigation.NavigateTo(url, replace: true);
    }
}
