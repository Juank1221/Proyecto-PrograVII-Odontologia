@using GestionOdontologica.Frontend.Models

@if (TotalRegistros > 0)
{
    <div class="data-pagination" role="navigation" aria-label="@($"Paginación de {Plural}")">
        @if (MostrarResumen)
        {
            <p class="data-pagination__summary">
                Mostrando <strong>@Inicio</strong>–<strong>@Fin</strong> de
                <strong>@TotalRegistros</strong> @(TotalRegistros == 1 ? Singular : Plural)
            </p>
        }

        <div class="data-pagination__controls">
            <label class="data-pagination__size">
                <span>Filas por página</span>
                <select aria-label="Registros por página"
                        @onchange="CambiarTamanoAsync">
                    @foreach (var opcion in OpcionesTamano)
                    {
                        <option value="@opcion" selected="@(opcion == TamanoPagina)">@opcion</option>
                    }
                </select>
            </label>

            <div class="data-pagination__pages">
                <button type="button"
                        class="pager-btn pager-btn--arrow"
                        disabled="@(PaginaEfectiva <= 1)"
                        aria-label="Primera página"
                        title="Primera página"
                        @onclick="() => IrAsync(1)">«</button>

                <button type="button"
                        class="pager-btn pager-btn--arrow"
                        disabled="@(PaginaEfectiva <= 1)"
                        aria-label="Página anterior"
                        title="Página anterior"
                        @onclick="() => IrAsync(PaginaEfectiva - 1)">‹</button>

                @foreach (var pagina in Paginas)
                {
                    if (pagina is null)
                    {
                        <span class="pager-ellipsis" aria-hidden="true">…</span>
                    }
                    else
                    {
                        <button type="button"
                                class="pager-btn @(pagina == PaginaEfectiva ? "is-active" : string.Empty)"
                                aria-current="@(pagina == PaginaEfectiva ? "page" : null)"
                                aria-label="@($"Página {pagina}")"
                                @onclick="() => IrAsync(pagina.Value)">@pagina</button>
                    }
                }

                <button type="button"
                        class="pager-btn pager-btn--arrow"
                        disabled="@(PaginaEfectiva >= TotalPaginas)"
                        aria-label="Página siguiente"
                        title="Página siguiente"
                        @onclick="() => IrAsync(PaginaEfectiva + 1)">›</button>

                <button type="button"
                        class="pager-btn pager-btn--arrow"
                        disabled="@(PaginaEfectiva >= TotalPaginas)"
                        aria-label="Última página"
                        title="Última página"
                        @onclick="() => IrAsync(TotalPaginas)">»</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly IReadOnlyList<int> OpcionesPorDefecto = Paginacion.OpcionesTamano;

    [Parameter]
    public int TotalRegistros { get; set; }

    [Parameter]
    public int PaginaActual { get; set; } = 1;

    [Parameter]
    public int TamanoPagina { get; set; } = 10;

    [Parameter]
    public EventCallback<int> OnPaginaCambiada { get; set; }

    [Parameter]
    public EventCallback<int> OnTamanoCambiado { get; set; }

    [Parameter]
    public string Singular { get; set; } = "registro";

    [Parameter]
    public string Plural { get; set; } = "registros";

    [Parameter]
    public bool MostrarResumen { get; set; } = true;

    [Parameter]
    public IReadOnlyList<int> OpcionesTamano { get; set; } = OpcionesPorDefecto;

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(TotalRegistros / (double)Math.Max(1, TamanoPagina)));

    private int PaginaEfectiva => Math.Clamp(PaginaActual, 1, TotalPaginas);

    private int Inicio => TotalRegistros == 0 ? 0 : (PaginaEfectiva - 1) * TamanoPagina + 1;

    private int Fin => Math.Min(PaginaEfectiva * TamanoPagina, TotalRegistros);

    private IReadOnlyList<int?> Paginas
    {
        get
        {
            var total = TotalPaginas;
            if (total <= 7)
            {
                return Enumerable.Range(1, total).Select(numero => (int?)numero).ToList();
            }

            var actual = PaginaEfectiva;
            var numeros = new SortedSet<int> { 1, total, actual - 1, actual, actual + 1 };
            numeros.RemoveWhere(numero => numero < 1 || numero > total);

            var resultado = new List<int?>();
            var anterior = 0;

            foreach (var numero in numeros)
            {
                if (anterior != 0 && numero - anterior > 1)
                {
                    resultado.Add(null);
                }

                resultado.Add(numero);
                anterior = numero;
            }

            return resultado;
        }
    }

    private Task IrAsync(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas || pagina == PaginaEfectiva)
        {
            return Task.CompletedTask;
        }

        return OnPaginaCambiada.InvokeAsync(pagina);
    }

    private Task CambiarTamanoAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var tamano) || tamano == TamanoPagina)
        {
            return Task.CompletedTask;
        }

        return OnTamanoCambiado.InvokeAsync(tamano);
    }
}
