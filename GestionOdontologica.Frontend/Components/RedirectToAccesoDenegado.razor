@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (ruta.StartsWith("acceso-denegado", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Navigation.NavigateTo("acceso-denegado", replace: true);
    }
}
