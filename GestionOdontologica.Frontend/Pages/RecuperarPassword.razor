@page "/recuperar-password"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthApiService Api

<AuthShell TituloPagina="Recuperar contraseña | OdontoCare"
           IdTitulo="recuperar-title"
           Etiqueta="Recuperación de acceso"
           Titulo="Recupera tu acceso sin perder el ritmo de la clínica."
           Descripcion="Indícanos el correo asociado a tu cuenta y te ayudaremos a crear una nueva contraseña."
           PiePagina="Los enlaces de recuperación expiran en 30 minutos">
    <AsideContent>
        <ul class="auth-benefits auth-benefits--steps">
            <li>
                <span class="auth-benefit__icon" aria-hidden="true">
                    <svg class="icon"><use href="#icon-mail"></use></svg>
                </span>
                <div>
                    <strong>1. Indica tu correo</strong>
                    <span>Usa el correo con el que fuiste registrado.</span>
                </div>
            </li>
            <li>
                <span class="auth-benefit__icon" aria-hidden="true">
                    <svg class="icon"><use href="#icon-key"></use></svg>
                </span>
                <div>
                    <strong>2. Recibe un enlace</strong>
                    <span>El enlace contiene un token de un solo uso.</span>
                </div>
            </li>
            <li>
                <span class="auth-benefit__icon" aria-hidden="true">
                    <svg class="icon"><use href="#icon-shield-check"></use></svg>
                </span>
                <div>
                    <strong>3. Crea una nueva contraseña</strong>
                    <span>Vuelve a entrar con tu clave actualizada.</span>
                </div>
            </li>
        </ul>
    </AsideContent>

    <ChildContent>
    <a class="auth-back-link" href="login">
        <svg class="icon" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
        Volver al inicio de sesión
    </a>

    <div class="auth-form-header">
        <span class="auth-form-icon" aria-hidden="true">
            <svg class="icon"><use href="#icon-mail"></use></svg>
        </span>
        <h2 id="recuperar-title">¿Olvidaste tu contraseña?</h2>
        <p>Escribe tu correo y te indicaremos cómo restablecerla.</p>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeError))
    {
        <div class="auth-alert auth-alert--error" role="alert">
            <svg class="icon" aria-hidden="true"><use href="#icon-alert"></use></svg>
            <div>
                <strong>No pudimos procesar la solicitud</strong>
                <p>@_mensajeError</p>
            </div>
        </div>
    }

    @if (_solicitudEnviada)
    {
        <div class="auth-success-panel" role="status">
            <span class="auth-success-icon" aria-hidden="true">
                <svg class="icon"><use href="#icon-check"></use></svg>
            </span>
            <h3>Solicitud registrada</h3>
            <p>@_mensajeExito</p>

            @if (!string.IsNullOrWhiteSpace(_tokenDesarrollo))
            {
                <div class="auth-dev-token">
                    <div class="auth-dev-token__head">
                        <svg class="icon" aria-hidden="true"><use href="#icon-key"></use></svg>
                        <strong>Token de desarrollo</strong>
                    </div>
                    <p>
                        No hay servidor SMTP configurado. Usa este token para completar el flujo
                        de demostración. Expira en @(_expiraEnMinutos ?? 30) minutos y solo puede usarse una vez.
                    </p>
                    <code>@_tokenDesarrollo</code>
                    <a class="button button--primary auth-submit"
                       href="@($"restablecer-password?token={Uri.EscapeDataString(_tokenDesarrollo)}")">
                        <svg class="icon" aria-hidden="true"><use href="#icon-key"></use></svg>
                        Continuar con este token
                    </a>
                </div>
            }

            <a class="button button--secondary auth-submit" href="login">
                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
                Volver a iniciar sesión
            </a>
        </div>
    }
    else
    {
        <EditForm Model="_modelo" OnValidSubmit="SolicitarRecuperacionAsync" class="auth-form">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="correo">Correo electrónico</label>
                <div class="auth-input">
                    <svg class="icon" aria-hidden="true"><use href="#icon-mail"></use></svg>
                    <InputText id="correo"
                               type="email"
                               @bind-Value="_modelo.Correo"
                               autocomplete="email"
                               placeholder="nombre@clinica.com"
                               autofocus />
                </div>
                <ValidationMessage For="() => _modelo.Correo" />
            </div>

            <button type="submit" class="button button--primary auth-submit" disabled="@_enviando">
                @if (_enviando)
                {
                    <span class="button__spinner" aria-hidden="true"></span>
                    <span>Enviando solicitud...</span>
                }
                else
                {
                    <svg class="icon" aria-hidden="true"><use href="#icon-mail"></use></svg>
                    <span>Enviar instrucciones</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer-meta">
            <svg class="icon" aria-hidden="true"><use href="#icon-shield-check"></use></svg>
            <span>Por seguridad, mostraremos el mismo mensaje exista o no el correo indicado.</span>
        </div>
    }
    </ChildContent>
</AuthShell>

@code {
    private readonly RecuperarPasswordFormModel _modelo = new();

    private bool _enviando;
    private bool _solicitudEnviada;
    private string _mensajeError = string.Empty;
    private string _mensajeExito = string.Empty;
    private string? _tokenDesarrollo;
    private int? _expiraEnMinutos;

    private async Task SolicitarRecuperacionAsync()
    {
        if (_enviando)
        {
            return;
        }

        _enviando = true;
        _mensajeError = string.Empty;

        try
        {
            var respuesta = await Api.SolicitarRecuperacionAsync(new RecuperarPasswordRequest
            {
                Correo = _modelo.Correo.Trim()
            });

            _mensajeExito = respuesta.Mensaje;
            _tokenDesarrollo = respuesta.TokenDesarrollo;
            _expiraEnMinutos = respuesta.ExpiraEnMinutos;
            _solicitudEnviada = true;
        }
        catch (ApiException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (Exception)
        {
            _mensajeError = "Ocurrió un error inesperado. Inténtalo nuevamente en unos segundos.";
        }
        finally
        {
            _enviando = false;
        }
    }
}
