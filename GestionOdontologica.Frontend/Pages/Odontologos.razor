    private async Task AbrirHorarios(OdontologoDto odontologo)
    {
        OdontologoSeleccionado = odontologo;
        ErrorHorarios = null;
        HorariosConfiguracion = new List<HorarioItemDto>();
        try
        {
            var existentes = await OdontologosApi.ObtenerHorariosAsync(odontologo.IdOdontologo);
            for (int i = 1; i <= 7; i++)
            {
                var ex = existentes.FirstOrDefault(h => h.DiaSemana == i);
                if (ex != null)
                {
                    HorariosConfiguracion.Add(new HorarioItemDto { DiaSemana = i, HoraInicio = ex.HoraInicio, HoraFin = ex.HoraFin, Activo = ex.Activo });
                }
                else
                {
                    HorariosConfiguracion.Add(new HorarioItemDto { DiaSemana = i, HoraInicio = "08:00", HoraFin = "17:00", Activo = false });
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.Mostrar("Error", ex.Message, ToastTipo.Error);
            for (int i = 1; i <= 7; i++)
            {
                HorariosConfiguracion.Add(new HorarioItemDto { DiaSemana = i, HoraInicio = "08:00", HoraFin = "17:00", Activo = false });
            }
        }
        MostrarHorarios = true;
    }

    private async Task GuardarHorariosAsync()
    {
        if (OdontologoSeleccionado == null) return;

        ErrorHorarios = ValidarHorarios();
        if (ErrorHorarios is not null)
        {
            ToastService.Mostrar("Horario inválido", ErrorHorarios, ToastTipo.Error);
            return;
        }

        try
        {
            GuardandoHorarios = true;
            var dto = new ConfiguracionHorariosDto { Horarios = HorariosConfiguracion.ToList() };
            await OdontologosApi.ConfigurarHorariosAsync(OdontologoSeleccionado.IdOdontologo, dto);
            ToastService.Mostrar("Éxito", "Horarios configurados correctamente.", ToastTipo.Exito);
            ErrorHorarios = null;
            CerrarHorarios();
        }
        catch (Exception ex)
        {
            ToastService.Mostrar("Error", ex.Message, ToastTipo.Error);
        }
        finally
        {
            GuardandoHorarios = false;
        }
    }

    private string? ValidarHorarios()
    {
        var activos = HorariosConfiguracion.Where(h => h.Activo).ToList();

        foreach (var horario in activos)
        {
            if (string.Compare(horario.HoraInicio, horario.HoraFin, StringComparison.Ordinal) >= 0)
            {
                return $"En {NombreDia(horario.DiaSemana)}, la hora de inicio ({horario.HoraInicio}) debe ser anterior a la hora de fin ({horario.HoraFin}).";
            }
        }

        foreach (var grupo in activos.GroupBy(h => h.DiaSemana))
        {
            var ordenados = grupo.OrderBy(h => MinutosDesdeMedianoche(h.HoraInicio)).ToList();

            for (var i = 1; i < ordenados.Count; i++)
            {
                var anterior = ordenados[i - 1];
                var actual = ordenados[i];
                var inicioActual = MinutosDesdeMedianoche(actual.HoraInicio);
                var finAnterior = MinutosDesdeMedianoche(anterior.HoraFin);

                if (inicioActual < finAnterior)
                {
                    var finTraslape = Math.Min(MinutosDesdeMedianoche(actual.HoraFin), finAnterior);
                    return $"Los horarios de {NombreDia(grupo.Key)} se traslapan entre {actual.HoraInicio} y {FormatearMinutos(finTraslape)}. Ajusta los turnos para que no se superpongan.";
                }
            }
        }

        return null;
    }

    private bool HorarioTraslapado(HorarioItemDto horario)
    {
        if (!horario.Activo)
        {
            return false;
        }

        var inicio = MinutosDesdeMedianoche(horario.HoraInicio);
        var fin = MinutosDesdeMedianoche(horario.HoraFin);

        return HorariosConfiguracion.Any(otro =>
            !ReferenceEquals(otro, horario) &&
            otro.Activo &&
            otro.DiaSemana == horario.DiaSemana &&
            inicio < MinutosDesdeMedianoche(otro.HoraFin) &&
            fin > MinutosDesdeMedianoche(otro.HoraInicio));
    }

    private static string FormatearMinutos(int minutos) =>
        $"{minutos / 60:00}:{minutos % 60:00}";

