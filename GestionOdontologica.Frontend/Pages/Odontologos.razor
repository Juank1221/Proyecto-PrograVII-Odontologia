        }
    }

    private async Task AsociarTratamientoAsync()
    {
        if (OdontologoSeleccionado == null || TratamientoAAsociarId == 0)
        {
            return;
        }

        var tratamientoActivo = CatalogoTratamientos.Any(t =>
            t.IdTratamiento == TratamientoAAsociarId && t.Activo);

        if (!tratamientoActivo)
        {
            ToastService.Mostrar(
                "Tratamiento no disponible",
                "El tratamiento seleccionado está inactivo o ya no está disponible. Actualiza el catálogo y selecciona otro tratamiento.",
                ToastTipo.Error);

            TratamientoAAsociarId = 0;
            TratamientoSeleccionado = null;
            await CargarCatalogoTratamientosAsync();
            return;
        }

        try
        {
            GuardandoTratamientos = true;
            await OdontologosApi.AsociarTratamientoAsync(OdontologoSeleccionado.IdOdontologo, TratamientoAAsociarId);
            ToastService.Mostrar("Éxito", "Tratamiento asociado correctamente.", ToastTipo.Exito);
            TratamientoAAsociarId = 0;
            TratamientoSeleccionado = null;
            BusquedaTratamiento = string.Empty;
            MostrarOpcionesTratamiento = false;
            await CargarTratamientosAsociadosAsync();
        }
        catch (Exception ex)
        {
            ToastService.Mostrar("Error", ex.Message, ToastTipo.Error);
        }
        finally
        {
            GuardandoTratamientos = false;
        }
    }

