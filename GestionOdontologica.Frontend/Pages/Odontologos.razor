    private static IReadOnlyList<string> CrearHorasDisponibles()
    {
        var horas = new List<string>();
        for (var minuto = MinutoInicioCalendario; minuto <= MinutoFinCalendario; minuto += 30)
        {
            horas.Add($"{minuto / 60:00}:{minuto % 60:00}");
        }
        return horas;
    }

    private static int MinutosDesdeMedianoche(string? hora)
    {
        return TimeSpan.TryParse(hora, out var tiempo) ? (int)tiempo.TotalMinutes : 0;
    }

    private static bool HorarioInvalido(HorarioItemDto horario)
    {
        return horario.Activo
            && string.CompareOrdinal(horario.HoraInicio, horario.HoraFin) >= 0;
    }

    private static double DuracionHoras(HorarioItemDto horario)
    {
        var minutos = Math.Max(0, MinutosDesdeMedianoche(horario.HoraFin) - MinutosDesdeMedianoche(horario.HoraInicio));
        return minutos / 60.0;
    }

    private static string DuracionBloque(HorarioItemDto horario)
    {
        var minutos = Math.Max(0, MinutosDesdeMedianoche(horario.HoraFin) - MinutosDesdeMedianoche(horario.HoraInicio));
        var horas = minutos / 60;
        var resto = minutos % 60;
        return resto == 0 ? $"{horas} h" : $"{horas} h {resto} min";
    }

    private static double PorcentajeHora(string hora)
    {
        var total = (double)(MinutoFinCalendario - MinutoInicioCalendario);
        var minuto = Math.Clamp(MinutosDesdeMedianoche(hora), MinutoInicioCalendario, MinutoFinCalendario);
        return (minuto - MinutoInicioCalendario) * 100.0 / total;
    }

    private static string EstiloBloqueCalendario(HorarioItemDto horario)
    {
        var total = (double)(MinutoFinCalendario - MinutoInicioCalendario);
        var inicio = Math.Clamp(MinutosDesdeMedianoche(horario.HoraInicio), MinutoInicioCalendario, MinutoFinCalendario);
        var fin = Math.Clamp(MinutosDesdeMedianoche(horario.HoraFin), MinutoInicioCalendario, MinutoFinCalendario);
        var arriba = (inicio - MinutoInicioCalendario) * 100.0 / total;
        var alto = Math.Max(2.0, (fin - inicio) * 100.0 / total);

        return string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "top:{0:0.##}%;height:{1:0.##}%;",
            arriba,
            alto);
    }

    private static string NombreDiaCorto(int dia) => dia switch
    {
        1 => "Lun",
        2 => "Mar",
        3 => "Mié",
        4 => "Jue",
        5 => "Vie",
        6 => "Sáb",
        7 => "Dom",
        _ => dia.ToString()
    };

    private static readonly System.Globalization.CultureInfo CulturaMonetaria =
        System.Globalization.CultureInfo.GetCultureInfo("es-CR");

    private static string FormatearMoneda(decimal monto) =>
        "₡" + monto.ToString("N2", CulturaMonetaria);

    private static string NombreDia(int dia) => dia switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        7 => "Domingo",
        _ => dia.ToString()
    };

