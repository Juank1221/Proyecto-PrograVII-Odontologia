@page "/odontologos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using GestionOdontologica.Frontend.Models
@using GestionOdontologica.Frontend.Services
@inject OdontologosApiService OdontologosApi
@inject TratamientosApiService TratamientosApi
@inject UsuariosApiService UsuariosApi
@inject ToastService ToastService

<PageTitle>Odontólogos</PageTitle>

<div class="usuarios-page">
    <header class="usuarios-page__header">
        <div>
            <h1>Odontólogos</h1>
            <p>Mantenimiento de odontólogos, configuración de horarios y asociación de tratamientos.</p>
        </div>
    </header>

    <div class="usuarios-layout">
        <section class="usuarios-card usuarios-card--form">
            <header class="usuarios-card__header">
                <div>
                    <h2>@(Editando ? "Editar odontólogo" : "Nuevo odontólogo")</h2>
                    <p>@(Editando ? "Actualiza los datos del perfil clínico del odontólogo." : "Vincula el perfil clínico con una cuenta de usuario de forma atómica.")</p>
                </div>
            </header>
            @if (!Editando)
            {
                <div class="form-section">
                    <div class="form-section__header">
                        <h3>Vinculación con cuenta de usuario</h3>
                        <p>Selecciona un usuario sin odontólogo o crea uno nuevo</p>
                    </div>
                    <div class="form-grid">
                        <div class="form-field form-field--span-2">
                            <label>Tipo de vinculación</label>
                            <InputSelect class="form-control" @bind-Value="TipoVinculacion" @bind-Value:after="OnTipoVinculacionChanged">
                                <option value="VINCULAR">Vincular a usuario con rol Odontólogo</option>
                                <option value="CREAR_USUARIO">Crear nuevo usuario y odontólogo</option>
                            </InputSelect>
                        </div>
                    </div>

                    @if (TipoVinculacion == "VINCULAR")
                    {
                        <div class="form-grid">
                            <div class="form-field form-field--span-2">
                                <label>Usuario disponible *</label>
                                <InputSelect class="form-control" @bind-Value="UsuarioSeleccionadoId" @bind-Value:after="OnUsuarioSeleccionadoChanged">
                                    <option value="0">Seleccione un usuario...</option>
                                    @foreach (var u in UsuariosSinOdontologo)
                                    {
                                        <option value="@u.IdUsuario">@u.NombreCompleto (@u.NombreUsuario) - @u.Correo</option>
                                    }
                                </InputSelect>
                                <small class="usuarios-table__meta">Al seleccionar el usuario se autocompletarán Nombres, Apellidos y Correo clínico en "Datos del odontólogo".</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="form-grid">
                            <div class="form-field form-field--span-2">
                                <label>Nombre completo del usuario *</label>
                                <InputText class="form-control" @bind-Value="UsuarioFormulario.NombreCompleto" />
                            </div>
                            <div class="form-field">
                                <label>Nombre de usuario *</label>
                                <InputText class="form-control" @bind-Value="UsuarioFormulario.NombreUsuario" />
                            </div>
                            <div class="form-field">
                                <label>Correo del usuario *</label>
                                <InputText class="form-control" @bind-Value="UsuarioFormulario.CorreoUsuario" />
                            </div>
                            <div class="form-field">
                                <label>Contraseña *</label>
                                <InputText type="password" class="form-control" @bind-Value="UsuarioFormulario.Password" />
                                <small class="field-hint">Mínimo 8 caracteres, sin letras ni números iguales consecutivos (aa, 11).</small>
                            </div>
                            <div class="form-field">
                                <label>Rol</label>
                                <InputSelect class="form-control" @bind-Value="UsuarioFormulario.Rol" disabled>
                                    <option value="Odontólogo">Odontólogo</option>
                                </InputSelect>
                            </div>
                        </div>
                    }
                </div>
            }

            <EditForm Model="Formulario" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <div class="form-section">
                    <div class="form-section__header">
                        <h3>Datos del odontólogo</h3>
                        <p>Información profesional y de contacto</p>
                    </div>
                    <div class="form-grid">
                        <div class="form-field form-field--span-2">
                            <label>Nombres *</label>
                            <InputText class="form-control" @bind-Value="Formulario.Nombres" />
                            <ValidationMessage For="@(() => Formulario.Nombres)" />
                        </div>
                        <div class="form-field form-field--span-2">
                            <label>Apellidos *</label>
                            <InputText class="form-control" @bind-Value="Formulario.Apellidos" />
                            <ValidationMessage For="@(() => Formulario.Apellidos)" />
                        </div>
                        <div class="form-field">
                            <label>Número de colegiado *</label>
                            <InputText class="form-control" @bind-Value="Formulario.NumeroColegiado" />
                            <ValidationMessage For="@(() => Formulario.NumeroColegiado)" />
                        </div>
                        <div class="form-field">
                            <label>Especialidad</label>
                            <InputSelect class="form-control" @bind-Value="Formulario.Especialidad">
                                <option value="">Seleccione una especialidad...</option>
                                @foreach (var especialidad in Especialidades)
                                {
                                    <option value="@especialidad">@especialidad</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Formulario.Especialidad) && !Especialidades.Contains(Formulario.Especialidad))
                                {
                                    <option value="@Formulario.Especialidad">@Formulario.Especialidad</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-field">
                            <label>Teléfono</label>
                            <InputText class="form-control" @bind-Value="Formulario.Telefono" />
                        </div>
                        <div class="form-field">
                            <label>Correo clínico</label>
                            <InputText class="form-control" @bind-Value="Formulario.Correo" />
                            <ValidationMessage For="@(() => Formulario.Correo)" />
                        </div>
                        @if (Editando)
                        {
                            <div class="form-field">
                                <label>ID Usuario (opcional)</label>
                                <InputNumber class="form-control" @bind-Value="Formulario.IdUsuario" />
                            </div>
                        }
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn--primary" type="submit" disabled="@Guardando">@((Guardando) ? "Guardando..." : (Editando ? "Guardar cambios" : "Registrar odontólogo vinculado"))</button>
                    <button class="btn btn--ghost" type="button" @onclick="CancelarEdicion" disabled="@Guardando">Cancelar</button>
                </div>
            </EditForm>
        </section>

        <section class="usuarios-card usuarios-card--list">
            <header class="usuarios-card__header">
                <div>
                    <h2>Listado de odontólogos</h2>
                    <p>@ListaOdontologos.Count odontólogo(s) registrados</p>
                </div>
                <div class="usuarios-card__header-actions">
                    <input class="form-control usuarios-search" placeholder="Buscar por nombre, apellido, colegiado o correo..." @bind="Filtro" @bind:event="oninput" />
                </div>
            </header>

            @if (Cargando)
            {
                <p>Cargando odontólogos...</p>
            }
            else if (!OdontologosFiltrados.Any())
            {
                <p>No hay odontólogos para mostrar.</p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="usuarios-table">
                        <thead>
                            <tr>
                                <th>Odontólogo</th>
                                <th>Colegiado</th>
                                <th>Especialidad</th>
                                <th>Contacto</th>
                                <th>Usuario vinculado</th>
                                <th>Estado</th>
                                <th class="usuarios-table__actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var odontologo in OdontologosPagina)
                            {
                                <tr>
                                    <td>
                                        <div class="usuarios-table__name">@odontologo.Nombres @odontologo.Apellidos</div>
                                    </td>
                                    <td>@odontologo.NumeroColegiado</td>
                                    <td>@(odontologo.Especialidad ?? "-")</td>
                                    <td>
                                        <div>@(odontologo.Telefono ?? "-")</div>
                                        <div class="usuarios-table__meta">@(odontologo.Correo ?? "-")</div>
                                    </td>
                                    <td>
                                        @if (odontologo.IdUsuario.HasValue)
                                        {
                                            <span class="badge badge--info">ID @odontologo.IdUsuario.Value</span>
                                        }
                                        else
                                        {
                                            <span class="usuarios-table__meta">Sin vincular</span>
                                        }
                                    </td>
                                    <td><span class="badge @(odontologo.Activo ? "badge--success" : "badge--danger")">@(odontologo.Activo ? "Activo" : "Inactivo")</span></td>
                                    <td class="usuarios-table__actions">
                                        <button class="btn btn--ghost btn--sm" @onclick="() => Editar(odontologo)">Editar</button>
                                        <button class="btn btn--ghost btn--sm" @onclick="() => AbrirHorarios(odontologo)">Horarios</button>
                                        <button class="btn btn--ghost btn--sm" @onclick="() => AbrirTratamientos(odontologo)">Tratamientos</button>
                                        @if (odontologo.Activo)
                                        {
                                            <button class="btn btn--ghost btn--sm" @onclick="() => SolicitarCambioEstado(odontologo, false)">Desactivar</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn--ghost btn--sm" @onclick="() => SolicitarCambioEstado(odontologo, true)">Activar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <DataPagination TotalRegistros="TotalFiltrados"
                                PaginaActual="_paginacion.PaginaEfectiva(TotalFiltrados)"
                                TamanoPagina="_paginacion.Tamano"
                                Singular="odontólogo"
                                Plural="odontólogos"
                                OnPaginaCambiada="IrAPagina"
                                OnTamanoCambiado="CambiarTamanoPagina" />
            }
        </section>
    </div>
</div>

@if (MostrarHorarios && OdontologoSeleccionado != null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-dialog--wide">
            <header class="modal-header">
                <div class="modal-header__title">
                    <h2>Agenda semanal</h2>
                    <p>@OdontologoSeleccionado.Nombres @OdontologoSeleccionado.Apellidos</p>
                </div>
                <button class="modal-close" @onclick="CerrarHorarios">×</button>
            </header>
            <div class="modal-body modal-body--wide">
                @if (!string.IsNullOrWhiteSpace(ErrorHorarios))
                {
                    <div class="agenda-alert" role="alert">
                        <svg class="icon" aria-hidden="true"><use href="#icon-alert"></use></svg>
                        <div>
                            <strong>Conflicto de horario</strong>
                            <span>@ErrorHorarios</span>
                        </div>
                    </div>
                }

                <div class="agenda-toolbar">
                    <div class="agenda-stats">
                        <div class="agenda-stat">
                            <span>Días habilitados</span>
                            <strong>@HorariosConfiguracion.Count(h => h.Activo)<small>/ 7</small></strong>
                        </div>
                        <div class="agenda-stat">
                            <span>Horas semanales</span>
                            <strong>@HorasSemanales.ToString("0.#")<small>h</small></strong>
                        </div>
                        <div class="agenda-stat">
                            <span>Jornada base</span>
                            <strong>08:00<small>a</small>17:00</strong>
                        </div>
                    </div>
                    <div class="agenda-actions">
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="AplicarJornadaEstandar">Aplicar 08:00 - 17:00</button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="MarcarLaborables">Lunes a viernes</button>
                        <button type="button" class="btn btn--ghost btn--sm" @onclick="LimpiarHorarios">Limpiar</button>
                    </div>
                </div>

                <div class="agenda-calendar-wrap">
                    <div class="agenda-calendar">
                        <div class="agenda-calendar__axis">
                            <div class="agenda-calendar__spacer"></div>
                            <div class="agenda-calendar__track agenda-calendar__track--axis">
                                @foreach (var hora in HorasEjeCalendario)
                                {
                                    <span style="top:@PorcentajeHora(hora).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">@hora</span>
                                }
                            </div>
                        </div>
                        @for (int i = 1; i <= 7; i++)
                        {
                            var diaCal = i;
                            var itemCal = HorariosConfiguracion.FirstOrDefault(h => h.DiaSemana == diaCal);
                            if (itemCal is null) { continue; }

                            <div class="agenda-calendar__day @(itemCal.Activo ? "is-active" : "")">
                                <div class="agenda-calendar__day-head">
                                    <strong>@NombreDiaCorto(diaCal)</strong>
                                    <span>@(itemCal.Activo ? $"{itemCal.HoraInicio} - {itemCal.HoraFin}" : "Libre")</span>
                                </div>
                                <div class="agenda-calendar__track">
                                    @if (itemCal.Activo)
                                    {
                                        <div class="agenda-calendar__block @(HorarioInvalido(itemCal) || HorarioTraslapado(itemCal) ? "is-invalid" : "")" style="@EstiloBloqueCalendario(itemCal)">
                                            <span>@itemCal.HoraInicio</span>
                                            <em>@DuracionBloque(itemCal)</em>
                                            <span>@itemCal.HoraFin</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="agenda-editors">
                    @for (int i = 1; i <= 7; i++)
                    {
                        var dia = i;
                        var item = HorariosConfiguracion.FirstOrDefault(h => h.DiaSemana == dia);
                        if (item is null) { continue; }

                        <article class="agenda-editor @(item.Activo ? "is-active" : "") @(HorarioInvalido(item) || HorarioTraslapado(item) ? "is-invalid" : "")">
                            <header class="agenda-editor__head">
                                <div class="agenda-editor__day">
                                    <span class="agenda-editor__indicator"></span>
                                    <div>
                                        <strong>@NombreDia(dia)</strong>
                                        <small>@(item.Activo ? $"Jornada de {DuracionBloque(item)}" : "Sin atención")</small>
                                    </div>
                                </div>
                                <label class="switch" title="Habilitar día">
                                    <input type="checkbox" @bind="item.Activo" />
                                    <span class="switch__slider"></span>
                                </label>
                            </header>
                            <div class="agenda-editor__times">
                                <label>
                                    <span>Inicio</span>
                                    <select class="form-control" @bind="item.HoraInicio" disabled="@(!item.Activo)">
                                        @foreach (var hora in HorasDisponibles)
                                        {
                                            <option value="@hora">@hora</option>
                                        }
                                    </select>
                                </label>
                                <span class="agenda-editor__arrow">→</span>
                                <label>
                                    <span>Fin</span>
                                    <select class="form-control" @bind="item.HoraFin" disabled="@(!item.Activo)">
                                        @foreach (var hora in HorasDisponibles)
                                        {
                                            <option value="@hora">@hora</option>
                                        }
                                    </select>
                                </label>
                            </div>
                            @if (item.Activo && HorarioInvalido(item))
                            {
                                <p class="agenda-editor__error">La hora de fin debe ser posterior al inicio.</p>
                            }
                            else if (item.Activo && HorarioTraslapado(item))
                            {
                                <p class="agenda-editor__error">Este turno se traslapa con otro horario del mismo día.</p>
                            }
                        </article>
                    }
                </div>
            </div>
            <footer class="modal-footer">
                <button class="btn btn--ghost" @onclick="CerrarHorarios">Cancelar</button>
                <button class="btn btn--primary" @onclick="GuardarHorariosAsync" disabled="@GuardandoHorarios">@((GuardandoHorarios) ? "Guardando..." : "Guardar horarios")</button>
            </footer>
        </div>
    </div>
}

@if (MostrarTratamientos && OdontologoSeleccionado != null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-dialog--wide">
            <header class="modal-header">
                <div class="modal-header__title">
                    <h2>Tratamientos</h2>
                    <p>@OdontologoSeleccionado.Nombres @OdontologoSeleccionado.Apellidos</p>
                </div>
                <button class="modal-close" @onclick="CerrarTratamientos">×</button>
            </header>
            <div class="modal-body modal-body--wide">
                <div class="treatment-stats">
                    <div class="treatment-stat">
                        <span>Tratamientos asociados</span>
                        <strong>@TratamientosActivos.Count</strong>
                    </div>
                    <div class="treatment-stat">
                        <span>Catálogo disponible</span>
                        <strong>@CatalogoTratamientos.Count</strong>
                    </div>
                    <div class="treatment-stat treatment-stat--money">
                        <span>Valor asociado</span>
                        <strong>@FormatearMoneda(TotalAsociado)</strong>
                    </div>
                </div>

                <section class="treatment-assign">
                    <div class="treatment-assign__header">
                        <div>
                            <h3>Asociar tratamiento</h3>
                            <p>Busca por código o nombre y selecciona el tratamiento del catálogo.</p>
                        </div>
                    </div>

                    <div class="combo">
                        <div class="combo__control @(MostrarOpcionesTratamiento ? "is-open" : "")">
                            <svg class="combo__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input class="form-control combo__input"
                                   placeholder="Buscar tratamiento por nombre o código..."
                                   @bind="BusquedaTratamiento"
                                   @bind:event="oninput"
                                   @bind:after="OnBusquedaTratamientoChanged"
                                   @onfocus="AbrirOpcionesTratamiento" />
                        </div>

                        @if (MostrarOpcionesTratamiento)
                        {
                            <div class="combo__menu">
                                @if (!TratamientosDisponiblesFiltrados.Any())
                                {
                                    <div class="combo__empty">No hay tratamientos activos que coincidan con la búsqueda.</div>
                                }
                                else
                                {
                                    @foreach (var t in TratamientosDisponiblesFiltrados)
                                    {
                                        <button type="button" class="combo__option" @onclick="() => SeleccionarTratamiento(t)">
                                            <span class="combo__code">@t.CodigoTratamiento</span>
                                            <span class="combo__name">@t.Nombre</span>
                                            <span class="combo__price">@FormatearMoneda(t.Precio)</span>
                                        </button>
                                    }
                                }
                            </div>
                        }

                        @if (TratamientoSeleccionado is not null)
                        {
                            <div class="combo__selection">
                                <span class="combo__code">@TratamientoSeleccionado.CodigoTratamiento</span>
                                <div class="combo__selection-info">
                                    <strong>@TratamientoSeleccionado.Nombre</strong>
                                    <span>@FormatearMoneda(TratamientoSeleccionado.Precio)</span>
                                </div>
                                <button type="button" class="combo__clear" @onclick="LimpiarSeleccionTratamiento" title="Quitar selección">×</button>
                            </div>
                        }
                    </div>

                    <div class="treatment-assign__footer">
                        <span class="treatment-assign__hint">
                            @(TratamientoSeleccionado is null
                                ? "Selecciona un tratamiento activo del catálogo para vincularlo."
                                : "Tratamiento seleccionado listo para asociar.")
                        </span>
                        <button type="button" class="btn btn--primary" @onclick="AsociarTratamientoAsync" disabled="@(GuardandoTratamientos || TratamientoAAsociarId == 0)">
                            @(GuardandoTratamientos ? "Asociando..." : "Asociar tratamiento")
                        </button>
                    </div>
                </section>

                <section class="treatment-list">
                    <div class="treatment-list__header">
                        <h3>Tratamientos vinculados</h3>
                        <span class="treatment-list__count">@TratamientosActivos.Count</span>
                    </div>

                    @if (!TratamientosActivos.Any())
                    {
                        <div class="empty-state empty-state--compact">
                            <strong>Sin tratamientos asociados</strong>
                            <span>Usa el buscador de arriba para vincular el primero.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var t in TratamientosActivos)
                        {
                            <article class="treatment-item">
                                <span class="treatment-item__code">@t.CodigoTratamiento</span>
                                <div class="treatment-item__info">
                                    <strong>@t.Nombre</strong>
                                    <span>@(string.IsNullOrWhiteSpace(t.Descripcion) ? "Sin descripción" : t.Descripcion)</span>
                                </div>
                                <span class="treatment-item__price">@FormatearMoneda(t.Precio)</span>
                                <span class="badge badge--success">Asociado</span>
                                <button type="button" class="btn btn--ghost btn--sm" @onclick="() => DesasociarTratamientoAsync(t.IdTratamiento)">Desasociar</button>
                            </article>
                        }
                    }
                </section>
            </div>
            <footer class="modal-footer">
                <button class="btn btn--ghost" @onclick="CerrarTratamientos">Cerrar</button>
            </footer>
        </div>
    </div>
}

<ConfirmModal Visible="MostrarConfirmacionEstado"
              Titulo="@TituloConfirmacionEstado"
              Mensaje="@MensajeConfirmacionEstado"
              Detalle="@DetalleConfirmacionEstado"
              BotonConfirmar="@(EstadoPendienteActivo ? "Activar odontólogo" : "Desactivar odontólogo")"
              EsPeligro="@(!EstadoPendienteActivo)"
              Icono="@(EstadoPendienteActivo ? "#icon-user-check" : "#icon-alert")"
              Cargando="ConfirmandoEstado"
              OnConfirmar="ConfirmarCambioEstadoAsync"
              OnCancelar="CerrarConfirmacionEstado" />

@code {
    private List<OdontologoDto> ListaOdontologos = new();
    private bool Cargando = true;
    private bool Guardando = false;
    private bool Editando = false;
    private int? IdOdontologoEditando;

    private OdontologoForm Formulario = new();
    private readonly Paginacion _paginacion = new();
    private string _filtro = string.Empty;

    private string Filtro
    {
        get => _filtro;
        set
        {
            _filtro = value;
            _paginacion.Reiniciar();
        }
    }

    private static readonly string[] Especialidades =
    {
        "Odontología General",
        "Ortodoncia",
        "Endodoncia",
        "Periodoncia",
        "Prostodoncia",
        "Implantología",
        "Odontopediatría",
        "Cirugía Oral y Maxilofacial",
        "Patología Oral",
        "Radiología Oral y Maxilofacial",
        "Estética Dental",
        "Rehabilitación Oral"
    };

    private string TipoVinculacion = "VINCULAR";
    private int UsuarioSeleccionadoId = 0;
    private List<UsuarioSinOdontologoDto> UsuariosSinOdontologo = new();
    private UsuarioVinculadoForm UsuarioFormulario = new();

    private bool MostrarHorarios = false;
    private OdontologoDto? OdontologoSeleccionado;
    private List<HorarioItemDto> HorariosConfiguracion = new();
    private bool GuardandoHorarios = false;
    private string? ErrorHorarios;

    private bool MostrarTratamientos = false;
    private List<TratamientoDto> CatalogoTratamientos = new();
    private List<TratamientoDto> TratamientosAsociados = new();
    private int TratamientoAAsociarId = 0;
    private bool GuardandoTratamientos = false;
    private string BusquedaTratamiento = string.Empty;
    private bool MostrarOpcionesTratamiento = false;
