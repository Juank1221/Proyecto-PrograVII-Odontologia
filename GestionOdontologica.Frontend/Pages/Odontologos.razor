    private void OnUsuarioSeleccionadoChanged()
    {
        if (TipoVinculacion != "VINCULAR" || UsuarioSeleccionadoId == 0)
        {
            return;
        }

        var usuario = UsuariosSinOdontologo.FirstOrDefault(u => u.IdUsuario == UsuarioSeleccionadoId);
        if (usuario == null)
        {
            return;
        }

        var nombreCompleto = (usuario.NombreCompleto ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(nombreCompleto))
        {
            var partes = nombreCompleto.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
            if (partes.Length == 1)
            {
                Formulario.Nombres = partes[0];
                Formulario.Apellidos = string.Empty;
            }
            else if (partes.Length >= 2)
            {
                Formulario.Apellidos = partes[partes.Length - 1];
                Formulario.Nombres = string.Join(" ", partes.Take(partes.Length - 1));
            }
        }

        if (!string.IsNullOrWhiteSpace(usuario.Correo))
        {
            Formulario.Correo = usuario.Correo;
        }
    }

    private void OnTipoVinculacionChanged()
    {
        UsuarioSeleccionadoId = 0;
        UsuarioFormulario = new UsuarioVinculadoForm { Rol = "Odontólogo" };

        if (TipoVinculacion == "CREAR_USUARIO")
        {
            Formulario.Nombres = string.Empty;
            Formulario.Apellidos = string.Empty;
            Formulario.Correo = string.Empty;
        }
    }

    private async Task GuardarAsync()
    {
        try
        {
            Guardando = true;
            if (Editando && IdOdontologoEditando.HasValue)
            {
                var dto = new ActualizacionOdontologoDto
                {
                    IdUsuario = Formulario.IdUsuario,
                    Nombres = Formulario.Nombres,
                    Apellidos = Formulario.Apellidos,
                    NumeroColegiado = Formulario.NumeroColegiado,
                    Especialidad = Formulario.Especialidad,
                    Telefono = Formulario.Telefono,
                    Correo = Formulario.Correo
                };
                await OdontologosApi.ActualizarAsync(IdOdontologoEditando.Value, dto);
                ToastService.Mostrar("Éxito", "Odontólogo actualizado correctamente.", ToastTipo.Exito);
                CancelarEdicion();
                await CargarAsync();
            }
            else
            {
                if (TipoVinculacion == "VINCULAR" && UsuarioSeleccionadoId == 0)
                {
                    ToastService.Mostrar("Error", "Debe seleccionar un usuario sin odontólogo para vincular.", ToastTipo.Error);
                    return;
                }

                if (TipoVinculacion == "CREAR_USUARIO")
                {
                    if (string.IsNullOrWhiteSpace(UsuarioFormulario.NombreCompleto) || string.IsNullOrWhiteSpace(UsuarioFormulario.NombreUsuario) || string.IsNullOrWhiteSpace(UsuarioFormulario.CorreoUsuario) || string.IsNullOrWhiteSpace(UsuarioFormulario.Password))
                    {
                        ToastService.Mostrar("Error", "Complete los datos obligatorios del usuario.", ToastTipo.Error);
                        return;
                    }

                    var erroresPassword = PasswordPolicy.ObtenerErrores(UsuarioFormulario.Password);
                    if (erroresPassword.Count > 0)
                    {
                        ToastService.Mostrar("Contraseña no válida", string.Join(" ", erroresPassword), ToastTipo.Error);
                        return;
                    }
                }

                var dtoVinculado = new CreacionOdontologoVinculadoDto
                {
                    TipoVinculacion = TipoVinculacion,
                    IdUsuario = TipoVinculacion == "VINCULAR" ? UsuarioSeleccionadoId : null,
                    NombreCompleto = UsuarioFormulario.NombreCompleto,
                    NombreUsuario = UsuarioFormulario.NombreUsuario,
                    CorreoUsuario = UsuarioFormulario.CorreoUsuario,
                    Password = UsuarioFormulario.Password,
                    Rol = "Odontólogo",
                    Nombres = Formulario.Nombres,
                    Apellidos = Formulario.Apellidos,
                    NumeroColegiado = Formulario.NumeroColegiado,
                    Especialidad = Formulario.Especialidad,
                    Telefono = Formulario.Telefono,
                    Correo = Formulario.Correo
                };
                await OdontologosApi.CrearVinculadoAsync(dtoVinculado);
                ToastService.Mostrar("Éxito", "Odontólogo vinculado/creado correctamente.", ToastTipo.Exito);
                CancelarEdicion();
                await CargarAsync();
                await CargarUsuariosSinOdontologoAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.Mostrar("Error", ex.Message, ToastTipo.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

