    private IEnumerable<TratamientoDto> TratamientosDisponiblesFiltrados
    {
        get
        {
            var asociados = TratamientosAsociados
                .Where(t => t.AsociadoActivo == true)
                .Select(t => t.IdTratamiento)
                .ToHashSet();

            var texto = BusquedaTratamiento.Trim();

            return CatalogoTratamientos
                .Where(t => t.Activo)
                .Where(t => !asociados.Contains(t.IdTratamiento))
                .Where(t => texto.Length == 0
                    || $"{t.CodigoTratamiento} {t.Nombre}".Contains(texto, StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.Nombre);
        }
    }

