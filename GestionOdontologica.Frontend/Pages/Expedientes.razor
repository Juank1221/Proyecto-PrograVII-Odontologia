    private void AplicarMedicamentoSeleccionado()
    {
        if (_medicamentoSeleccionado == "__otro__")
        {
            _medicamentoEsOtro = true;
            _nuevoMedicamento = new FormMedicamento();
            return;
        }

        _medicamentoEsOtro = false;
        var medicamento = _catalogoMedicamentos.FirstOrDefault(m =>
            string.Equals(m.NombreMedicamento, _medicamentoSeleccionado, StringComparison.OrdinalIgnoreCase));

        _nuevoMedicamento = medicamento is null
            ? new FormMedicamento()
            : new FormMedicamento
            {
                NombreMedicamento = medicamento.NombreMedicamento,
                Dosis = medicamento.Dosis,
                Frecuencia = medicamento.Frecuencia,
                Duracion = medicamento.Duracion,
                Indicaciones = medicamento.Indicaciones,
                Precio = medicamento.Precio.ToString("0.00", CultureInfo.InvariantCulture)
            };
    }

    private async Task GuardarTratamientoAsync(int idAtencion)
    {
        if (_nuevoTratamiento.IdTratamiento <= 0)
        {
            ToastService.Mostrar("Datos incompletos", "Selecciona un tratamiento del catálogo.", ToastTipo.Error);
            return;
        }

        if (!TryParsearPrecio(_nuevoTratamiento.Precio, out var precio))
        {
            ToastService.Mostrar("Datos inválidos", "El precio aplicado no es un número válido.", ToastTipo.Error);
            return;
        }

        var dto = new CreacionTratamientoAtencionDto
        {
            IdTratamiento = _nuevoTratamiento.IdTratamiento,
            PrecioAplicado = precio,
            Descripcion = Nulo(_nuevoTratamiento.Descripcion)
        };

        await EjecutarAsync(async () =>
        {
            if (_detalleTratamientoEditando is int idDetalle)
            {
                await ExpedientesApi.ActualizarTratamientoAsync(idDetalle, dto);
            }
            else
            {
                await ExpedientesApi.RegistrarTratamientoAsync(idAtencion, dto);
            }

            CerrarFormularioTratamiento();
            _detalles[idAtencion] = await ExpedientesApi.ObtenerDetalleAtencionAsync(idAtencion);
        }, "Tratamiento guardado.");
    }

    private async Task GuardarMedicamentoAsync(int idAtencion)
    {
        if (string.IsNullOrWhiteSpace(_nuevoMedicamento.NombreMedicamento))
        {
            ToastService.Mostrar(
                "Datos incompletos",
                _medicamentoEsOtro
                    ? "Escribe el nombre del medicamento."
                    : "Selecciona un medicamento o elige la opción Otro.",
                ToastTipo.Error);
            return;
        }

        if (!TryParsearPrecio(_nuevoMedicamento.Precio, out var precioMedicamento))
        {
            ToastService.Mostrar("Datos inválidos", "El precio del medicamento no es un número válido.", ToastTipo.Error);
            return;
        }

        var dto = new CreacionMedicamentoIndicadoDto
        {
            NombreMedicamento = _nuevoMedicamento.NombreMedicamento.Trim(),
            Dosis = Nulo(_nuevoMedicamento.Dosis),
            Frecuencia = Nulo(_nuevoMedicamento.Frecuencia),
            Duracion = Nulo(_nuevoMedicamento.Duracion),
            Indicaciones = Nulo(_nuevoMedicamento.Indicaciones),
            Precio = precioMedicamento
        };

        await EjecutarAsync(async () =>
        {
            if (_medicamentoEditando is int idMedicamento)
            {
                await ExpedientesApi.ActualizarMedicamentoAsync(idMedicamento, dto);
            }
            else
            {
                await ExpedientesApi.RegistrarMedicamentoAsync(idAtencion, dto);
            }

            CerrarFormularioMedicamento();
            _detalles[idAtencion] = await ExpedientesApi.ObtenerDetalleAtencionAsync(idAtencion);
        }, "Medicamento guardado.");
    }

    private async Task GuardarExamenAsync()
    {
        if (_pacienteSeleccionado is null) return;

        if (string.IsNullOrWhiteSpace(_nuevoExamen.TipoExamen))
        {
            ToastService.Mostrar("Datos incompletos", "El tipo de examen es obligatorio.", ToastTipo.Error);
            return;
        }

        var idAtencion = (int?)null;
        if (!string.IsNullOrWhiteSpace(_nuevoExamen.IdAtencion))
        {
            if (!int.TryParse(_nuevoExamen.IdAtencion, NumberStyles.Integer, CultureInfo.InvariantCulture, out var valor) || valor <= 0)
            {
                ToastService.Mostrar("Datos inválidos", "El ID de la atención no es válido.", ToastTipo.Error);
                return;
            }
            idAtencion = valor;
        }

        var idPaciente = _pacienteSeleccionado.IdPaciente;
        await EjecutarAsync(async () =>
        {
            await ExpedientesApi.RegistrarExamenAsync(idPaciente, new CreacionExamenDto
            {
                IdAtencion = idAtencion,
                TipoExamen = _nuevoExamen.TipoExamen.Trim(),
                FechaSolicitud = Fecha(_nuevoExamen.FechaSolicitud),
                FechaRealizacion = Fecha(_nuevoExamen.FechaRealizacion),
                Observaciones = Nulo(_nuevoExamen.Observaciones)
            });
            _nuevoExamen = new FormExamen();
            _mostrarNuevoExamen = false;
            await CargarExamenesAsync();
        }, "Examen registrado.");
    }

    private void IniciarResultadoExamen(ExamenDto examen)
    {
        _examenEditando = _examenEditando == examen.IdExamen ? null : examen.IdExamen;
        _formResultado = new FormResultado
        {
            Estado = examen.Estado == "Solicitado" && examen.FechaRealizacion is null ? "Solicitado" : examen.Estado,
            FechaRealizacion = examen.FechaRealizacion?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty,
            Resultado = examen.Resultado ?? string.Empty,
            Observaciones = examen.Observaciones ?? string.Empty
        };
    }

    private async Task GuardarResultadoExamenAsync(int idExamen)
    {
        if (_formResultado.Estado == "Realizado" && (Fecha(_formResultado.FechaRealizacion) is null || string.IsNullOrWhiteSpace(_formResultado.Resultado)))
        {
            ToastService.Mostrar("Datos incompletos", "Un examen realizado requiere fecha de realización y resultado.", ToastTipo.Error);
            return;
        }

        await EjecutarAsync(async () =>
        {
            await ExpedientesApi.RegistrarResultadoExamenAsync(idExamen, new ActualizacionResultadoExamenDto
            {
                Estado = _formResultado.Estado,
                FechaRealizacion = Fecha(_formResultado.FechaRealizacion),
                Resultado = Nulo(_formResultado.Resultado),
                Observaciones = Nulo(_formResultado.Observaciones)
            });
            _examenEditando = null;
            await CargarExamenesAsync();
        }, "Resultado guardado.");
    }

    private async Task EjecutarAsync(Func<Task> operacion, string mensajeExito)
    {
        try
        {
            _guardando = true;
            await operacion();
            ToastService.Mostrar("Listo", mensajeExito, ToastTipo.Exito);
        }
        catch (Exception ex)
        {
            ToastService.Mostrar("No se pudo guardar", ex.Message, ToastTipo.Error);
        }
        finally
        {
            _guardando = false;
        }
    }

    private static bool Contiene(string? valor, string termino) =>
        !string.IsNullOrEmpty(valor) && valor.Contains(termino, StringComparison.OrdinalIgnoreCase);

    private static string? Nulo(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private static DateTime? Fecha(string? texto) =>
        DateTime.TryParseExact(texto, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha)
            ? fecha
            : null;

    private static bool TryParsearPrecio(string? texto, out decimal? precio)
    {
        precio = null;
        if (string.IsNullOrWhiteSpace(texto)) return true;

        // El campo se llena con punto decimal (Invariant). Se intenta primero
        // ese formato para que valores como "90000.00" no se interpreten como
        // millones en culturas donde el punto es separador de miles.
        if (decimal.TryParse(texto, NumberStyles.Number, CultureInfo.InvariantCulture, out var valor)
            || decimal.TryParse(texto, NumberStyles.Number, CultureInfo.CurrentCulture, out valor))
        {
            precio = valor;
            return valor >= 0;
        }

        return false;
    }

    private static string Iniciales(PacienteDto paciente)
    {
        var inicial1 = paciente.Nombres.Trim().FirstOrDefault();
        var inicial2 = paciente.Apellidos.Trim().FirstOrDefault();
        return $"{inicial1}{inicial2}".ToUpperInvariant();
    }

    private static string ClaseEstadoExamen(string estado) => estado switch
    {
        "Realizado" => "badge--success",
        "Cancelado" => "badge--danger",
        "En proceso" => "badge--info",
        _ => "badge--neutral"
    };

