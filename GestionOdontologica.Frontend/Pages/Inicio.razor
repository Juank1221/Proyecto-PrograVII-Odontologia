@page "/inicio"
@attribute [Authorize]

<PageTitle>Inicio | OdontoCare</PageTitle>

<div class="page">
    <section class="page-heading" aria-labelledby="page-title">
        <div class="page-heading__copy">
            <h1 id="page-title">Inicio</h1>
            <p>Panel principal de OdontoCare.</p>
        </div>
    </section>

    <section class="card placeholder-card">
        <div class="table-state">
            <div class="table-state__icon" aria-hidden="true">
                <svg class="icon"><use href="#icon-home"></use></svg>
            </div>
            <strong>Bienvenido a OdontoCare</strong>
            <p>Utiliza el menú lateral para navegar por los módulos del sistema.</p>
        </div>
    </section>
</div>
