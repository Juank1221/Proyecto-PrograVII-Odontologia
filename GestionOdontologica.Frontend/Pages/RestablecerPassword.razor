@page "/restablecer-password"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthApiService Api

<AuthShell TituloPagina="Restablecer contraseña | OdontoCare"
           IdTitulo="restablecer-title"
           Etiqueta="Nueva contraseña"
           Titulo="Un nuevo acceso, con la misma tranquilidad de siempre."
           Descripcion="Crea una contraseña segura y vuelve a entrar para continuar con la gestión de la clínica."
           PiePagina="El token es de un solo uso y expira en 30 minutos">
    <AsideContent>
        <ul class="auth-benefits auth-benefits--steps">
            <li>
                <span class="auth-benefit__icon" aria-hidden="true">
                    <svg class="icon"><use href="#icon-key"></use></svg>
                </span>
                <div>
                    <strong>Token de un solo uso</strong>
                    <span>Una vez restablecida la contraseña, el enlace deja de funcionar.</span>
                </div>
            </li>
            <li>
                <span class="auth-benefit__icon" aria-hidden="true">
                    <svg class="icon"><use href="#icon-lock"></use></svg>
                </span>
                <div>
                    <strong>Contraseña protegida</strong>
                    <span>La clave se almacena cifrada con un algoritmo seguro.</span>
                </div>
            </li>
            <li>
                <span class="auth-benefit__icon" aria-hidden="true">
                    <svg class="icon"><use href="#icon-clock"></use></svg>
                </span>
                <div>
                    <strong>Bloqueos liberados</strong>
                    <span>Al restablecer la clave se reinician los intentos fallidos.</span>
                </div>
            </li>
        </ul>
    </AsideContent>

    <ChildContent>
    <a class="auth-back-link" href="login">
        <svg class="icon" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
        Volver al inicio de sesión
    </a>

    <div class="auth-form-header">
        <span class="auth-form-icon" aria-hidden="true">
            <svg class="icon"><use href="#icon-key"></use></svg>
        </span>
        <h2 id="restablecer-title">Crea tu nueva contraseña</h2>
        <p>Elige una clave de entre 8 y 72 caracteres, sin letras ni números iguales consecutivos.</p>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeError))
    {
        <div class="auth-alert auth-alert--error" role="alert">
            <svg class="icon" aria-hidden="true"><use href="#icon-alert"></use></svg>
            <div>
                <strong>No pudimos restablecer la contraseña</strong>
                <p>@_mensajeError</p>
                @if (_tokenInvalido)
                {
                    <a class="auth-inline-link" href="recuperar-password">Solicitar un nuevo enlace</a>
                }
            </div>
        </div>
    }

    @if (_restablecido)
    {
        <div class="auth-success-panel" role="status">
            <span class="auth-success-icon" aria-hidden="true">
                <svg class="icon"><use href="#icon-check"></use></svg>
            </span>
            <h3>Contraseña actualizada</h3>
            <p>@_mensajeExito</p>
            <a class="button button--primary auth-submit" href="login">
                <svg class="icon" aria-hidden="true"><use href="#icon-lock"></use></svg>
                Iniciar sesión
            </a>
        </div>
    }
    else
    {
        <EditForm Model="_modelo" OnValidSubmit="RestablecerAsync" class="auth-form">
            <DataAnnotationsValidator />

            @if (_tokenDesdeEnlace)
            {
                <div class="auth-token-loaded">
                    <span class="auth-token-loaded__icon" aria-hidden="true">
                        <svg class="icon"><use href="#icon-key"></use></svg>
                    </span>
                    <div>
                        <strong>Token cargado desde el enlace</strong>
                        <code>@Token</code>
                    </div>
                </div>
                <ValidationMessage For="() => _modelo.Token" />
            }
            else
            {
                <div class="field">
                    <label for="token">Token de recuperación</label>
                    <div class="auth-input">
                        <svg class="icon" aria-hidden="true"><use href="#icon-key"></use></svg>
                        <InputText id="token"
                                   @bind-Value="_modelo.Token"
                                   autocomplete="off"
                                   placeholder="Pega el token recibido"
                                   autofocus />
                    </div>
                    <ValidationMessage For="() => _modelo.Token" />
                </div>
            }

            <div class="field">
                <label for="nueva-password">Nueva contraseña</label>
                <div class="auth-input password-control">
                    <svg class="icon" aria-hidden="true"><use href="#icon-lock"></use></svg>
                    <InputText id="nueva-password"
                               type="@(_mostrarPassword ? "text" : "password")"
                               @bind-Value="_modelo.Password"
                               autocomplete="new-password"
                               placeholder="Mínimo 8 caracteres, sin repeticiones" />
                    <button type="button"
                            class="password-toggle"
                            aria-label="@(_mostrarPassword ? "Ocultar contraseñas" : "Mostrar contraseñas")"
                            @onclick="AlternarPassword">
                        <svg class="icon"><use href="@(_mostrarPassword ? "#icon-eye-off" : "#icon-eye")"></use></svg>
                    </button>
                </div>
                <ValidationMessage For="() => _modelo.Password" />
            </div>

            <div class="field">
                <label for="confirmar-password">Confirmar contraseña</label>
                <div class="auth-input password-control">
                    <svg class="icon" aria-hidden="true"><use href="#icon-shield-check"></use></svg>
                    <InputText id="confirmar-password"
                               type="@(_mostrarPassword ? "text" : "password")"
                               @bind-Value="_modelo.ConfirmarPassword"
                               autocomplete="new-password"
                               placeholder="Repite la contraseña" />
                </div>
                <ValidationMessage For="() => _modelo.ConfirmarPassword" />
            </div>

            <ul class="auth-password-hints">
                <li><svg class="icon"><use href="#icon-check"></use></svg> Mínimo 8 caracteres (máximo 72).</li>
                <li><svg class="icon"><use href="#icon-check"></use></svg> Sin letras iguales consecutivas (aa, bb).</li>
                <li><svg class="icon"><use href="#icon-check"></use></svg> Sin números iguales consecutivos (11, 22).</li>
                <li><svg class="icon"><use href="#icon-check"></use></svg> Ambas contraseñas deben coincidir.</li>
            </ul>

            <button type="submit" class="button button--primary auth-submit" disabled="@_enviando">
                @if (_enviando)
                {
                    <span class="button__spinner" aria-hidden="true"></span>
                    <span>Actualizando contraseña...</span>
                }
                else
                {
                    <svg class="icon" aria-hidden="true"><use href="#icon-shield-check"></use></svg>
                    <span>Restablecer contraseña</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer-meta">
            <svg class="icon" aria-hidden="true"><use href="#icon-clock"></use></svg>
            <span>Si el enlace expiró, solicita uno nuevo desde la pantalla de recuperación.</span>
        </div>
    }
    </ChildContent>
</AuthShell>

@code {
    private readonly RestablecerPasswordFormModel _modelo = new();

    private bool _enviando;
    private bool _mostrarPassword;
    private bool _restablecido;
    private bool _tokenInvalido;
    private bool _tokenDesdeEnlace;
    private string _mensajeError = string.Empty;
    private string _mensajeExito = string.Empty;

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Token))
        {
            _modelo.Token = Token.Trim();
            _tokenDesdeEnlace = true;
        }
    }

    private void AlternarPassword()
    {
        _mostrarPassword = !_mostrarPassword;
    }

    private async Task RestablecerAsync()
    {
        if (_enviando)
        {
            return;
        }

        _enviando = true;
        _mensajeError = string.Empty;
        _tokenInvalido = false;

        try
        {
            var respuesta = await Api.RestablecerPasswordAsync(new RestablecerPasswordRequest
            {
                Token = _modelo.Token.Trim(),
                Password = _modelo.Password
            });

            _mensajeExito = respuesta.Mensaje;
            _restablecido = true;
            _modelo.Password = string.Empty;
            _modelo.ConfirmarPassword = string.Empty;
        }
        catch (ApiException ex)
        {
            _mensajeError = ex.Message;
            _tokenInvalido = ex.Status == 400;
        }
        catch (Exception)
        {
            _mensajeError = "Ocurrió un error inesperado. Inténtalo nuevamente en unos segundos.";
        }
        finally
        {
            _enviando = false;
        }
    }
}
